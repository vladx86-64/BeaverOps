package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link
				href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap"
				rel="stylesheet"
			/>
			<link rel="icon" type="image/x-icon" href="/static/favicon.ico"/>
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body>
			<div class="wrap">
				<div class="topbar">
					<div class="brand">
						<div class="brand-mark">BEAVER<span>OPS</span></div>
						<div class="brand-sub">{ "// operation beaver readout" }</div>
					</div>
					<div class="status-cluster">
						<div class="status-live"><span class="dot"></span> OFFLINE</div>
						<div id="sync-time">SYNCED --:--:--</div>
					</div>
				</div>
				{ children... }
			</div>
		</body>
	</html>
}
